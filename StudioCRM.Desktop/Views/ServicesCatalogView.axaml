<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StudioCRM.Desktop.ViewModels"
             xmlns:models="using:StudioCRM.Core.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="StudioCRM.Desktop.Views.ServicesCatalogView"
             x:DataType="vm:ServicesCatalogViewModel"
             Background="#0B0F19">

    <Grid>
        <!-- MAIN CONTENT -->
        <Grid RowDefinitions="Auto,*" Margin="28,24,28,24">
            <!-- TOP BAR: CATEGORY FILTER & SEARCH -->
            <Border Grid.Row="0" Classes="Card" Margin="0,0,0,16" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <!-- Category Combo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="Категория:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="13" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  Width="220"
                                  Background="#0F172A"
                                  BorderBrush="#334155"
                                  CornerRadius="8" />
                    </StackPanel>

                    <!-- Search Box -->
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="🔍 Поиск по названию или описанию услуги..."
                             Background="#0F172A"
                             BorderBrush="#334155"
                             CornerRadius="8"
                             Padding="12,8"
                             Margin="0,0,12,0" />

                    <!-- Refresh -->
                    <Button Grid.Column="2"
                            Classes="Secondary"
                            Command="{Binding LoadServicesCommand}"
                            Margin="0,0,10,0">
                        <TextBlock Text="🔄 Обновить" FontSize="13" />
                    </Button>

                    <!-- Add Service Button -->
                    <Button Grid.Column="3"
                            Classes="Primary"
                            Command="{Binding OpenCreateServiceCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="＋" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Новая услуга" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- SERVICES DATAGRID -->
            <Border Grid.Row="1" Classes="Card" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding FilteredServices}"
                              SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              RowHeight="50"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <!-- Category Badge -->
                            <DataGridTemplateColumn Header="Категория" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ServiceItem">
                                        <Border Background="#1E293B"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Margin="8,0">
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="#A5B4FC" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Title -->
                            <DataGridTemplateColumn Header="Наименование услуги" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ServiceItem">
                                        <StackPanel VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Billing Type -->
                            <DataGridTemplateColumn Header="Тип тарификации" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ServiceItem">
                                        <TextBlock Text="{Binding BillingType, Converter={StaticResource BillingTypeToStringConverter}}"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Default Price -->
                            <DataGridTemplateColumn Header="Базовая цена" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ServiceItem">
                                        <TextBlock Text="{Binding DefaultPrice, Converter={StaticResource CurrencyFormatConverter}}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#34D399"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Unit -->
                            <DataGridTextColumn Header="Ед. изм." Binding="{Binding Unit}" Width="100" />

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Действия" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ServiceItem">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Button Content="Правка"
                                                    Classes="Secondary"
                                                    Padding="8,4"
                                                    FontSize="11"
                                                    Command="{Binding $parent[UserControl].((vm:ServicesCatalogViewModel)DataContext).OpenEditServiceCommand}"
                                                    CommandParameter="{Binding}" />

                                            <Button Content="✕"
                                                    Classes="Danger"
                                                    Padding="8,4"
                                                    FontSize="11"
                                                    Command="{Binding $parent[UserControl].((vm:ServicesCatalogViewModel)DataContext).DeleteServiceCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state -->
                    <StackPanel IsVisible="{Binding !FilteredServices.Count}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center" />
                        <TextBlock Text="Услуги не найдены" FontSize="15" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- SLIDE-OVER / MODAL SERVICE EDITOR -->
        <Border IsVisible="{Binding IsEditorOpen}"
                Background="#80000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="14"
                    Width="500"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="28"
                    BoxShadow="0 20 40 0 #000000">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding EditorTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC" />
                        <Button Grid.Column="1"
                                Content="✕"
                                Classes="Secondary"
                                Padding="8,4"
                                Command="{Binding CloseEditorCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#EF4444"
                               FontSize="12"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Category -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Категория *" FontSize="12" Foreground="#94A3B8" />
                        <TextBox Text="{Binding ServiceCategory, Mode=TwoWay}"
                                 PlaceholderText="Например: Веб-разработка, Мобильная разработка..."
                                 Background="#0F172A" />
                    </StackPanel>

                    <!-- Title -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Наименование услуги *" FontSize="12" Foreground="#94A3B8" />
                        <TextBox Text="{Binding ServiceTitle, Mode=TwoWay}"
                                 PlaceholderText="Например: Разработка Telegram Mini App"
                                 Background="#0F172A" />
                    </StackPanel>

                    <!-- Billing Type, Price, Unit -->
                    <Grid ColumnDefinitions="*,10,*,10,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Тарификация" FontSize="12" Foreground="#94A3B8" />
                            <ComboBox ItemsSource="{Binding BillingTypes}"
                                      SelectedItem="{Binding ServiceBillingType, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      Background="#0F172A">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource BillingTypeToStringConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Базовая цена (₽)" FontSize="12" Foreground="#94A3B8" />
                            <NumericUpDown Value="{Binding ServicePrice, Mode=TwoWay}"
                                           Minimum="0"
                                           FormatString="N0"
                                           Background="#0F172A" />
                        </StackPanel>

                        <StackPanel Grid.Column="4" Spacing="4">
                            <TextBlock Text="Ед. изм." FontSize="12" Foreground="#94A3B8" />
                            <TextBox Text="{Binding ServiceUnit, Mode=TwoWay}"
                                     PlaceholderText="проект, час..."
                                     Background="#0F172A" />
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Описание услуги" FontSize="12" Foreground="#94A3B8" />
                        <TextBox Text="{Binding ServiceDescription, Mode=TwoWay}"
                                 PlaceholderText="Подробное описание состава работ..."
                                 AcceptsReturn="True"
                                 Height="70"
                                 Background="#0F172A" />
                    </StackPanel>

                    <!-- Buttons -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                Classes="Secondary"
                                Content="Отмена"
                                Command="{Binding CloseEditorCommand}"
                                HorizontalAlignment="Left" />

                        <Button Grid.Column="1"
                                Classes="Primary"
                                Content="Сохранить"
                                Command="{Binding SaveServiceCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

