<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StudioCRM.Desktop.ViewModels"
             xmlns:models="using:StudioCRM.Core.Models"
             xmlns:enums="using:StudioCRM.Core.Enums"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="1200"
             x:Class="StudioCRM.Desktop.Views.OrderEditView"
             x:DataType="vm:OrderEditViewModel"
             Background="#0B0F19">

    <Grid RowDefinitions="Auto,*">
        <!-- TOP ACTION BAR -->
        <Border Grid.Row="0"
                Background="#111827"
                BorderBrush="#1F2937"
                BorderThickness="0,0,0,1"
                Padding="28,14">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <!-- Back Button -->
                <Button Grid.Column="0"
                        Classes="Secondary"
                        Command="{Binding BackCommand}"
                        Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="←" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="К списку" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Order Title / Number -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding OrderNumber}" FontWeight="Bold" FontSize="16" Foreground="#818CF8" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#34D399" />
                </StackPanel>

                <!-- Status Selector -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Статус заказа:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="13" />
                    <ComboBox ItemsSource="{Binding OrderStatuses}"
                              SelectedItem="{Binding Status, Mode=TwoWay}"
                              Width="150"
                              Background="#0F172A"
                              BorderBrush="#334155"
                              CornerRadius="8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource OrderStatusToStringConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Delete Button -->
                <Button Grid.Column="3"
                        Classes="Danger"
                        Command="{Binding DeleteOrderCommand}"
                        IsVisible="{Binding IsExistingOrder}"
                        Margin="0,0,10,0">
                    <TextBlock Text="🗑 Удалить заказ" FontSize="13" />
                </Button>

                <!-- Save Button -->
                <Button Grid.Column="4"
                        Classes="Primary"
                        Command="{Binding SaveOrderCommand}"
                        IsEnabled="{Binding !IsSaving}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="Сохранить проект" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- SCROLLABLE FORM BODY -->
        <ScrollViewer Grid.Row="1" Padding="28,24">
            <StackPanel Spacing="24">

                <!-- 1. ОСНОВНЫЕ ПАРАМЕТРЫ ЗАКАЗА -->
                <Border Classes="Card">
                    <StackPanel Spacing="16">
                        <TextBlock Text="1. Основные сведения о проекте"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC" />

                        <Grid ColumnDefinitions="*,24,*">
                            <!-- Left: Title, Client, Dates -->
                            <StackPanel Grid.Column="0" Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Название проекта *" FontSize="12" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Title, Mode=TwoWay}"
                                             PlaceholderText="Например: Редизайн сайта и личный кабинет"
                                             Background="#0F172A"
                                             BorderBrush="#334155"
                                             CornerRadius="8"
                                             Padding="12,8" />
                                </StackPanel>

                                <!-- Client Selector + Quick Add -->
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Заказчик / Клиент *" FontSize="12" Foreground="#94A3B8" />
                                        <Button Grid.Column="1"
                                                Classes="Secondary"
                                                Command="{Binding ToggleQuickClientCommand}"
                                                Padding="8,2"
                                                FontSize="11">
                                            <TextBlock Text="+ Новый клиент" />
                                        </Button>
                                    </Grid>

                                    <ComboBox ItemsSource="{Binding AvailableClients}"
                                              SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              Background="#0F172A"
                                              BorderBrush="#334155"
                                              CornerRadius="8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:Client">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- INLINE QUICK CLIENT CREATOR -->
                                <Border IsVisible="{Binding IsQuickClientOpen}"
                                        Background="#1E1B4B"
                                        BorderBrush="#6366F1"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,4,0,0">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Быстрое добавление клиента" FontWeight="SemiBold" FontSize="13" Foreground="#A5B4FC" />
                                        <TextBox Text="{Binding QuickClientName, Mode=TwoWay}" PlaceholderText="Название компании / ФИО" Background="#0F172A" />
                                        <Grid ColumnDefinitions="*,10,*">
                                            <TextBox Grid.Column="0" Text="{Binding QuickClientPhone, Mode=TwoWay}" PlaceholderText="Телефон" Background="#0F172A" />
                                            <TextBox Grid.Column="2" Text="{Binding QuickClientTelegram, Mode=TwoWay}" PlaceholderText="Telegram" Background="#0F172A" />
                                        </Grid>
                                        <TextBox Text="{Binding QuickClientEmail, Mode=TwoWay}" PlaceholderText="Email" Background="#0F172A" />
                                        <Button Classes="Primary"
                                                Command="{Binding CreateQuickClientCommand}"
                                                HorizontalAlignment="Right"
                                                Padding="12,6">
                                            <TextBlock Text="Добавить и выбрать" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Dates -->
                                <Grid ColumnDefinitions="*,12,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Дата старта" FontSize="12" Foreground="#94A3B8" />
                                        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay, Converter={StaticResource DateTimeToOffsetConverter}}"
                                                    HorizontalAlignment="Stretch"
                                                    Background="#0F172A" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="Дедлайн" FontSize="12" Foreground="#94A3B8" />
                                        <DatePicker SelectedDate="{Binding Deadline, Mode=TwoWay, Converter={StaticResource DateTimeToOffsetConverter}}"
                                                    HorizontalAlignment="Stretch"
                                                    Background="#0F172A" />
                                    </StackPanel>
                                </Grid>

                                <!-- Manual Project Cost -->
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Стоимость проекта / Сумма договора (₽)" FontSize="12" Foreground="#94A3B8" />
                                        <Button Grid.Column="1"
                                                Classes="Secondary"
                                                Command="{Binding CalculateCostFromItemsCommand}"
                                                Padding="8,2"
                                                FontSize="11">
                                            <TextBlock Text="⚡ Рассчитать по смете" />
                                        </Button>
                                    </Grid>
                                    <NumericUpDown Value="{Binding TotalCost, Mode=TwoWay}"
                                                   Minimum="0"
                                                   Increment="5000"
                                                   FormatString="N0"
                                                   Background="#0F172A"
                                                   BorderBrush="#334155"
                                                   CornerRadius="8"
                                                   Padding="12,8"
                                                   HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: URLs & Notes -->
                            <StackPanel Grid.Column="2" Spacing="14">
                                <!-- Git Repo URL -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Репозиторий Git" FontSize="12" Foreground="#94A3B8" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Text="{Binding RepositoryUrl, Mode=TwoWay}"
                                                 PlaceholderText="https://github.com/org/repo"
                                                 Background="#0F172A"
                                                 BorderBrush="#334155"
                                                 CornerRadius="8"
                                                 Margin="0,0,8,0" />
                                        <Button Grid.Column="1"
                                                Classes="Secondary"
                                                Command="{Binding OpenUrlCommand}"
                                                CommandParameter="{Binding RepositoryUrl}"
                                                Content="🔗" />
                                    </Grid>
                                </StackPanel>

                                <!-- Figma URL -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Дизайн-макет (Figma)" FontSize="12" Foreground="#94A3B8" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Text="{Binding DesignUrl, Mode=TwoWay}"
                                                 PlaceholderText="https://figma.com/file/..."
                                                 Background="#0F172A"
                                                 BorderBrush="#334155"
                                                 CornerRadius="8"
                                                 Margin="0,0,8,0" />
                                        <Button Grid.Column="1"
                                                Classes="Secondary"
                                                Command="{Binding OpenUrlCommand}"
                                                CommandParameter="{Binding DesignUrl}"
                                                Content="🎨" />
                                    </Grid>
                                </StackPanel>

                                <!-- Notes -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Заметки и ТЗ" FontSize="12" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Notes, Mode=TwoWay}"
                                             PlaceholderText="Краткое описание, договоренности, особенности проекта..."
                                             AcceptsReturn="True"
                                             Height="80"
                                             Background="#0F172A"
                                             BorderBrush="#334155"
                                             CornerRadius="8" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. СМЕТА И СОСТАВ УСЛУГ -->
                <Border Classes="Card">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="2. Смета и состав услуг"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#F8FAFC" />
                                <TextBlock Text="Выбирайте позиции из прайса (50+ услуг) или добавляйте индивидуальные работы"
                                           FontSize="12"
                                           Foreground="#94A3B8" />
                            </StackPanel>

                            <!-- Add Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <ComboBox ItemsSource="{Binding AvailableServices}"
                                          SelectedItem="{Binding SelectedCatalogService, Mode=TwoWay}"
                                          Width="300"
                                          Background="#0F172A"
                                          BorderBrush="#334155"
                                          CornerRadius="8"
                                          PlaceholderText="Выберите услугу из каталога...">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ServiceItem">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Classes="Primary"
                                        Command="{Binding AddServiceFromCatalogCommand}">
                                    <TextBlock Text="＋ В смету" FontSize="13" />
                                </Button>

                                <Button Classes="Secondary"
                                        Command="{Binding AddCustomItemCommand}">
                                    <TextBlock Text="＋ Своя позиция" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ITEMS DATAGRID -->
                        <DataGrid ItemsSource="{Binding Items}"
                                  AutoGenerateColumns="False"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="44"
                                  Background="#0F172A"
                                  BorderBrush="#334155"
                                  BorderThickness="1"
                                  CornerRadius="8">
                            <DataGrid.Columns>
                                <!-- Title -->
                                <DataGridTemplateColumn Header="Наименование работы / услуги" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:OrderItemViewModel">
                                            <TextBox Text="{Binding Title, Mode=TwoWay}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Billing Type -->
                                <DataGridTemplateColumn Header="Тарификация" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:OrderItemViewModel">
                                            <TextBlock Text="{Binding BillingType, Converter={StaticResource BillingTypeToStringConverter}}"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Price -->
                                <DataGridTemplateColumn Header="Цена (₽)" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:OrderItemViewModel">
                                            <NumericUpDown Value="{Binding Price, Mode=TwoWay}"
                                                           Minimum="0"
                                                           FormatString="N0"
                                                           Background="Transparent"
                                                           BorderThickness="0"
                                                           VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Quantity -->
                                <DataGridTemplateColumn Header="Кол-во" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:OrderItemViewModel">
                                            <NumericUpDown Value="{Binding Quantity, Mode=TwoWay}"
                                                           Minimum="0.1"
                                                           Increment="1"
                                                           FormatString="N1"
                                                           Background="Transparent"
                                                           BorderThickness="0"
                                                           VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Subtotal -->
                                <DataGridTemplateColumn Header="Сумма" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:OrderItemViewModel">
                                            <TextBlock Text="{Binding Subtotal, Converter={StaticResource CurrencyFormatConverter}}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F8FAFC"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Completed -->
                                <DataGridTemplateColumn Header="Готово" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:OrderItemViewModel">
                                            <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Delete Action -->
                                <DataGridTemplateColumn Header="" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:OrderItemViewModel">
                                            <Button Content="✕"
                                                    Classes="Danger"
                                                    Padding="6,2"
                                                    FontSize="11"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:OrderEditViewModel)DataContext).RemoveItemCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- TOTALS ROW -->
                        <Border Background="#111827" CornerRadius="8" Padding="16,12">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="ИТОГОВАЯ СТОИМОСТЬ ПРОЕКТА:"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="#94A3B8" />
                                    <TextBlock Text="Задается вручную или рассчитывается по смете"
                                               FontSize="11"
                                               Foreground="#64748B" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Classes="Secondary"
                                        Command="{Binding CalculateCostFromItemsCommand}"
                                        Content="⚡ Рассчитать по смете"
                                        Margin="16,0"
                                        VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="3"
                                               Value="{Binding TotalCost, Mode=TwoWay}"
                                               Minimum="0"
                                               Increment="5000"
                                               FormatString="N0"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Foreground="#34D399"
                                               Background="#0F172A"
                                               BorderBrush="#334155"
                                               CornerRadius="8"
                                               Width="200"
                                               VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. ЭТАПЫ ПРОЕКТА -->
                <Border Classes="Card">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="3. Чек-лист этапов разработки"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#F8FAFC" />
                                <TextBlock Text="Отслеживайте прогресс выполнения ключевых вех проекта"
                                           FontSize="12"
                                           Foreground="#94A3B8" />
                            </StackPanel>

                            <!-- Progress percentage badge -->
                            <Border Grid.Column="1"
                                    Background="#312E81"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='Прогресс: {0}%'}"
                                           FontWeight="SemiBold"
                                           Foreground="#A5B4FC"
                                           FontSize="12" />
                            </Border>

                            <Button Grid.Column="2"
                                    Classes="Secondary"
                                    Command="{Binding AddStageCommand}">
                                <TextBlock Text="＋ Добавить этап" FontSize="13" />
                            </Button>
                        </Grid>

                        <!-- Stages DataGrid -->
                        <DataGrid ItemsSource="{Binding Stages}"
                                  AutoGenerateColumns="False"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="44"
                                  Background="#0F172A"
                                  BorderBrush="#334155"
                                  BorderThickness="1"
                                  CornerRadius="8">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Завершен" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:OrderStageViewModel">
                                            <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Название этапа" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:OrderStageViewModel">
                                            <TextBox Text="{Binding Title, Mode=TwoWay}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Дедлайн" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:OrderStageViewModel">
                                            <DatePicker SelectedDate="{Binding Deadline, Mode=TwoWay, Converter={StaticResource DateTimeToOffsetConverter}}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:OrderStageViewModel">
                                            <Button Content="✕"
                                                    Classes="Danger"
                                                    Padding="6,2"
                                                    FontSize="11"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:OrderEditViewModel)DataContext).RemoveStageCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- 4. ПЛАТЕЖИ И ФИНАНСОВЫЙ БЛОК -->
                <Border Classes="Card">
                    <StackPanel Spacing="16">
                        <TextBlock Text="4. Поступления оплат и расчет остатка"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC" />

                        <!-- Mini Financial Summary -->
                        <Grid ColumnDefinitions="*,*,*">
                            <Border Grid.Column="0" Background="#111827" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Сумма договора" FontSize="11" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding TotalCost, Converter={StaticResource CurrencyFormatConverter}}"
                                               FontWeight="Bold" FontSize="18" Foreground="#F8FAFC" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#064E3B" CornerRadius="8" Padding="14,10" Margin="4,0,4,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Внесено клиентом" FontSize="11" Foreground="#A7F3D0" />
                                    <TextBlock Text="{Binding PaidAmount, Converter={StaticResource CurrencyFormatConverter}}"
                                               FontWeight="Bold" FontSize="18" Foreground="#34D399" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#7F1D1D" CornerRadius="8" Padding="14,10" Margin="8,0,0,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Остаток к доплате" FontSize="11" Foreground="#FCA5A5" />
                                    <TextBlock Text="{Binding RemainingDebt, Converter={StaticResource CurrencyFormatConverter}}"
                                               FontWeight="Bold" FontSize="18" Foreground="#F87171" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Payments Table -->
                        <DataGrid ItemsSource="{Binding Payments}"
                                  AutoGenerateColumns="False"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="40"
                                  Background="#0F172A"
                                  BorderBrush="#334155"
                                  BorderThickness="1"
                                  CornerRadius="8">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Дата" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:PaymentViewModel">
                                            <TextBlock Text="{Binding PaymentDate, Converter={StaticResource DateTimeFormatConverter}}"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Сумма (₽)" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:PaymentViewModel">
                                            <TextBlock Text="{Binding Amount, Converter={StaticResource CurrencyFormatConverter}}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#34D399"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Тип оплаты" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:PaymentViewModel">
                                            <TextBlock Text="{Binding PaymentType, Converter={StaticResource PaymentTypeToStringConverter}}"
                                                       Foreground="#E2E8F0"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Заметка" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:PaymentViewModel">
                                            <TextBlock Text="{Binding Notes}"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:PaymentViewModel">
                                            <Button Content="✕"
                                                    Classes="Danger"
                                                    Padding="6,2"
                                                    FontSize="11"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:OrderEditViewModel)DataContext).RemovePaymentCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Add Payment Row -->
                        <Border Background="#111827" CornerRadius="8" Padding="14,10">
                            <Grid ColumnDefinitions="140,160,*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                    <TextBlock Text="Сумма платежа" FontSize="11" Foreground="#94A3B8" />
                                    <NumericUpDown Value="{Binding NewPaymentAmount, Mode=TwoWay}"
                                                   Minimum="0"
                                                   FormatString="N0"
                                                   Background="#0F172A" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,8,0">
                                    <TextBlock Text="Способ оплаты" FontSize="11" Foreground="#94A3B8" />
                                    <ComboBox ItemsSource="{Binding PaymentTypes}"
                                              SelectedItem="{Binding NewPaymentType, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              Background="#0F172A">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource PaymentTypeToStringConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="4" Margin="0,0,8,0">
                                    <TextBlock Text="Комментарий" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding NewPaymentNotes, Mode=TwoWay}"
                                             PlaceholderText="Например: Аванс 50% по счету №..."
                                             Background="#0F172A" />
                                </StackPanel>

                                <Button Grid.Column="3"
                                        Classes="Primary"
                                        Command="{Binding AddPaymentCommand}"
                                        VerticalAlignment="Bottom">
                                    <TextBlock Text="＋ Внести платеж" FontSize="13" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

