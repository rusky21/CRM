<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StudioCRM.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             x:Class="StudioCRM.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="#0B0F19">

    <ScrollViewer Padding="32,28">
        <StackPanel Spacing="24" MaxWidth="820" HorizontalAlignment="Left">

            <!-- HEADER -->
            <StackPanel Spacing="6">
                <TextBlock Text="Настройки сервера и синхронизации"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#F9FAFB" />
                <TextBlock Text="Сохранение IP-адреса сервера для единой базы данных и синхронизации между всеми устройствами."
                           FontSize="13"
                           Foreground="#94A3B8" />
            </StackPanel>

            <!-- 1. SERVER IP ADDRESS CONFIGURATION (ALWAYS VISIBLE & PROMINENT) -->
            <Border Classes="Card" BorderBrush="#4F46E5" BorderThickness="1.5">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="🌐 IP-адрес сервера StudioCRM"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#818CF8" />
                            <TextBlock Text="Введите IP сервера (порт :5000 и протокол http:// добавятся автоматически):"
                                       FontSize="13"
                                       Foreground="#94A3B8" />
                        </StackPanel>

                        <!-- Saved badge -->
                        <Border Grid.Column="1"
                                Background="#1E1B4B"
                                BorderBrush="#4338CA"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentSavedServerUrl, StringFormat='Сохранено: {0}'}"
                                       FontSize="12"
                                       Foreground="#A5B4FC"
                                       FontWeight="Medium" />
                        </Border>
                    </Grid>

                    <!-- Host / IP input with Save Button -->
                    <Grid ColumnDefinitions="*,12,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding ServerUrl, Mode=TwoWay}"
                                 PlaceholderText="212.67.15.218:5000"
                                 Background="#0F172A"
                                 BorderBrush="#475569"
                                 CornerRadius="8"
                                 Padding="14,11"
                                 FontSize="15"
                                 FontWeight="Medium" />

                        <Button Grid.Column="2"
                                Classes="Primary"
                                Command="{Binding SaveAndConnectRemoteCommand}"
                                Padding="20,11">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="💾" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="Сохранить IP и подключиться" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Quick Presets -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Быстрый выбор:" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" />
                        <Button Classes="Secondary"
                                Command="{Binding SetStudioServerPresetCommand}"
                                Padding="10,5"
                                FontSize="12">
                            <TextBlock Text="☁️ Сервер студии (212.67.15.218:5000)" Foreground="#818CF8" />
                        </Button>
                        <Button Classes="Secondary"
                                Command="{Binding SetLocalhostPresetCommand}"
                                Padding="10,5"
                                FontSize="12">
                            <TextBlock Text="💻 Localhost (127.0.0.1:5000)" />
                        </Button>
                        <Button Classes="Secondary"
                                Command="{Binding SetLanPresetCommand}"
                                Padding="10,5"
                                FontSize="12">
                            <TextBlock Text="🏢 Офис LAN (192.168.1.100:5000)" />
                        </Button>
                    </StackPanel>

                    <!-- Test Connection Button & Result -->
                    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                        <Button Grid.Column="0"
                                Classes="Secondary"
                                Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding !IsTesting}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⚡" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="Проверить соединение" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding TestResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding TestResultText}"
                                       Foreground="#38BDF8"
                                       FontWeight="Medium"
                                       FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <!-- Live Save Feedback -->
                    <Border Background="#064E3B"
                            BorderBrush="#059669"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            IsVisible="{Binding SaveMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding SaveMessage}"
                                   Foreground="#34D399"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. STORAGE MODE SELECTION (Local SQLite vs Remote Server) -->
            <Border Classes="Card">
                <StackPanel Spacing="16">
                    <TextBlock Text="2. Режим хранения данных"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#F8FAFC" />

                    <Grid ColumnDefinitions="*,16,*">
                        <!-- Local SQLite Card -->
                        <Border Grid.Column="0"
                                Background="#1E293B"
                                CornerRadius="10"
                                Padding="16"
                                Cursor="Hand">
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding SelectLocalModeCommand}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Width="36" Height="36" CornerRadius="8" Background="#1E293B" VerticalAlignment="Center">
                                            <TextBlock Text="💻" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Локальный режим" FontWeight="SemiBold" FontSize="15" Foreground="#F8FAFC" />
                                            <TextBlock Text="Файл SQLite (studiocrm.db)" FontSize="12" Foreground="#94A3B8" />
                                        </StackPanel>
                                        <RadioButton Grid.Column="2"
                                                     IsChecked="{Binding IsLocalMode, Mode=OneWay}"
                                                     IsHitTestVisible="False"
                                                     VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Все данные хранятся локально на этом ПК. Доступно без интернета, без синхронизации."
                                               FontSize="12"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Remote Server Card -->
                        <Border Grid.Column="2"
                                Background="#1E293B"
                                CornerRadius="10"
                                Padding="16"
                                Cursor="Hand">
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding SelectRemoteModeCommand}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Width="36" Height="36" CornerRadius="8" Background="#1E3A8A" VerticalAlignment="Center">
                                            <TextBlock Text="🌐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Сетевой сервер" FontWeight="SemiBold" FontSize="15" Foreground="#818CF8" />
                                            <TextBlock Text="StudioCRM.Api + PostgreSQL" FontSize="12" Foreground="#94A3B8" />
                                        </StackPanel>
                                        <RadioButton Grid.Column="2"
                                                     IsChecked="{Binding IsRemoteMode, Mode=OneWay}"
                                                     IsHitTestVisible="False"
                                                     VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Синхронизация заказов, клиентов и оплат между всеми компьютерами через общий сервер студии."
                                               FontSize="12"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. PERSISTENCE INFO & SAVE ALL -->
            <Border Classes="Card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding CurrentStorageModeText, StringFormat='Активный источник данных: {0}'}"
                                   Foreground="#F9FAFB"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="Настройки сохраняются в settings.json рядом с приложением и в AppData."
                                   FontSize="12"
                                   Foreground="#64748B" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Classes="Secondary"
                            Command="{Binding SaveSettingsCommand}"
                            Padding="20,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Сохранить настройки" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
