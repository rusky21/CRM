<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StudioCRM.Desktop.ViewModels"
             xmlns:models="using:StudioCRM.Core.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="StudioCRM.Desktop.Views.ClientsView"
             x:DataType="vm:ClientsViewModel"
             Background="#0B0F19">

    <Grid>
        <!-- MAIN CONTENT -->
        <Grid RowDefinitions="Auto,*" Margin="28,24,28,24">
            <!-- TOP BAR -->
            <Border Grid.Row="0" Classes="Card" Margin="0,0,0,16" Padding="14,12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <!-- Search -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="🔍 Поиск по названию компании, имени, телефону, telegram или email..."
                             Background="#0F172A"
                             BorderBrush="#334155"
                             CornerRadius="8"
                             Padding="12,8"
                             Margin="0,0,12,0" />

                    <!-- Refresh -->
                    <Button Grid.Column="1"
                            Classes="Secondary"
                            Command="{Binding LoadClientsCommand}"
                            Margin="0,0,10,0">
                        <TextBlock Text="🔄 Обновить" FontSize="13" />
                    </Button>

                    <!-- Add Client Button -->
                    <Button Grid.Column="2"
                            Classes="Primary"
                            Command="{Binding OpenCreateClientCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="＋" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Добавить клиента" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- CLIENTS DATAGRID -->
            <Border Grid.Row="1" Classes="Card" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding FilteredClients}"
                              SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              RowHeight="50"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <!-- ID -->
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />

                            <!-- Company / Name -->
                            <DataGridTemplateColumn Header="Компания / Клиент" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Client">
                                        <StackPanel VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                            <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Contact Person -->
                            <DataGridTextColumn Header="Контактное лицо" Binding="{Binding ContactPerson}" Width="160" />

                            <!-- Phone -->
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150" />

                            <!-- Telegram -->
                            <DataGridTemplateColumn Header="Telegram" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Client">
                                        <TextBlock Text="{Binding Telegram}"
                                                   Foreground="#38BDF8"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Email -->
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180" />

                            <!-- Orders Count -->
                            <DataGridTemplateColumn Header="Заказов" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Client">
                                        <Border Background="#1E293B" CornerRadius="6" Padding="8,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Orders.Count}" FontWeight="Bold" Foreground="#818CF8" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Действия" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Client">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Button Content="Правка"
                                                    Classes="Secondary"
                                                    Padding="8,4"
                                                    FontSize="11"
                                                    Command="{Binding $parent[UserControl].((vm:ClientsViewModel)DataContext).OpenEditClientCommand}"
                                                    CommandParameter="{Binding}" />

                                            <Button Content="✕"
                                                    Classes="Danger"
                                                    Padding="8,4"
                                                    FontSize="11"
                                                    Command="{Binding $parent[UserControl].((vm:ClientsViewModel)DataContext).DeleteClientCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state -->
                    <StackPanel IsVisible="{Binding !FilteredClients.Count}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="👥" FontSize="32" HorizontalAlignment="Center" />
                        <TextBlock Text="Клиенты не найдены" FontSize="15" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- SLIDE-OVER / MODAL CLIENT EDITOR -->
        <Border IsVisible="{Binding IsEditorOpen}"
                Background="#80000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="14"
                    Width="500"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="28"
                    BoxShadow="0 20 40 0 #000000">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding EditorTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC" />
                        <Button Grid.Column="1"
                                Content="✕"
                                Classes="Secondary"
                                Padding="8,4"
                                Command="{Binding CloseEditorCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#EF4444"
                               FontSize="12"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Name -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Название компании / ФИО клиента *" FontSize="12" Foreground="#94A3B8" />
                        <TextBox Text="{Binding ClientName, Mode=TwoWay}"
                                 PlaceholderText="ООО «Название» или Иван Иванов"
                                 Background="#0F172A" />
                    </StackPanel>

                    <!-- Contact Person -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Контактное лицо" FontSize="12" Foreground="#94A3B8" />
                        <TextBox Text="{Binding ContactPerson, Mode=TwoWay}"
                                 PlaceholderText="ФИО представителя или ЛПР"
                                 Background="#0F172A" />
                    </StackPanel>

                    <!-- Phone & Telegram -->
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Телефон" FontSize="12" Foreground="#94A3B8" />
                            <TextBox Text="{Binding Phone, Mode=TwoWay}"
                                     PlaceholderText="+7 (999) 000-00-00"
                                     Background="#0F172A" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Telegram" FontSize="12" Foreground="#94A3B8" />
                            <TextBox Text="{Binding Telegram, Mode=TwoWay}"
                                     PlaceholderText="@username"
                                     Background="#0F172A" />
                        </StackPanel>
                    </Grid>

                    <!-- Email -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Email" FontSize="12" Foreground="#94A3B8" />
                        <TextBox Text="{Binding Email, Mode=TwoWay}"
                                 PlaceholderText="client@company.com"
                                 Background="#0F172A" />
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Заметки" FontSize="12" Foreground="#94A3B8" />
                        <TextBox Text="{Binding Notes, Mode=TwoWay}"
                                 PlaceholderText="Особенности работы, специфика, условия договоров..."
                                 AcceptsReturn="True"
                                 Height="70"
                                 Background="#0F172A" />
                    </StackPanel>

                    <!-- Buttons -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                Classes="Secondary"
                                Content="Отмена"
                                Command="{Binding CloseEditorCommand}"
                                HorizontalAlignment="Left" />

                        <Button Grid.Column="1"
                                Classes="Primary"
                                Content="Сохранить"
                                Command="{Binding SaveClientCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

