# ==============================================================================
# StudioCRM Production Environment Configuration Example
# Copy to .env and adjust credentials
# ==============================================================================

PROJECT_NAME="StudioCRM Multi-Account Telegram"
DEBUG=False
API_V1_PREFIX="/api/v1"

# AES-256-GCM 32-Byte Secret Encryption Key for MTProto Sessions (openssl rand -hex 32)
SECRET_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Database Configuration (PostgreSQL 16 Asyncpg)
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=studiocrm_db
DATABASE_URL=postgresql+asyncpg://crm_admin:your_secure_postgres_password@postgres:5432/studiocrm_db

# Redis Event Bus & Pub/Sub
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL=redis://:your_secure_redis_password@redis:6379/0

# Default MTProto App Credentials (my.telegram.org)
DEFAULT_TELEGRAM_API_ID=2040
DEFAULT_TELEGRAM_API_HASH="b18441a1ff607e10a989891a5462e627"

# Admin Bot & Alerts (@BotFather)
ADMIN_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
ADMIN_CHAT_ID=123456789
TMA_BOT_USERNAME="StudioCrmAdminBot"
TMA_APP_SHORT_NAME="app"

# Integration with Existing StudioCRM (ASP.NET on port 5000)
STUDIOCRM_SERVER_URL="http://212.67.15.218:5000"
STUDIOCRM_SQLITE_PATH="studiocrm.db"

# Public Hosting Domain or IP
HOST_DOMAIN="212.67.15.218"
